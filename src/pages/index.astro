---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import AthleticsSection from '../components/AthleticsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ResumeConnectSection from '../components/ResumeConnectSection.astro';
---

<BaseLayout
  title="Ryan Wenstrom | Data & Analytics Portfolio"
  description="Finance-trained data and analytics professional combining business judgment with Python, SQL, data engineering, and visualization."
>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="container hero-inner">
        <p class="eyebrow">DATA &amp; ANALYTICS PORTFOLIO</p>
        <h1>Ryan Wenstrom</h1>

        <p class="positioning">
          Finance-trained data &amp; analytics professional
        </p>

        <p class="intro">
          UC Berkeley MIDS candidate combining business judgment with Python,
          SQL, data engineering, and visualization to build reliable analytical
          systems and turn complex data into clear decision-support tools.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            View Projects
          </a>

          <a
            class="button button-secondary"
            href="/resumes/Ryan_Wenstrom_Analytics_Resume.pdf"
            target="_blank"
          >
            Resume
          </a>
        </div>

        <div class="hero-links" aria-label="Professional links">
          <a
            href="https://github.com/Ryan-Wenstrom-Portfolio"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>

          <span aria-hidden="true">&middot;</span>

          <a
            href="https://www.linkedin.com/in/ryanwenstrom/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>

          <span aria-hidden="true">&middot;</span>

          <a href="mailto:ryanmwenstrom@gmail.com">
            ryanmwenstrom@gmail.com
          </a>
        </div>

        <div class="credibility" aria-label="Background highlights">
          <span>UC Berkeley MIDS</span>
          <span class="divider" aria-hidden="true"></span>
          <span>Cal Poly Finance</span>
          <span class="divider" aria-hidden="true"></span>
          <span>Analytics + Finance</span>
        </div>
      </div>
    </section>

    <section class="projects-section" id="projects">
      <div class="container">
        <div class="section-heading">
          <p class="section-eyebrow">SELECTED WORK</p>

          <h2>Four projects. Four different analytical problems.</h2>

          <p>
            Large-scale data processing, relational analytics and data
            engineering, interactive visualization, and graph analysis — all
            focused on turning difficult data into something understandable and
            useful.
          </p>
        </div>

        <div class="project-grid">
          <ProjectCard
            eyebrow="Mortgage Analytics"
            title="Mortgage Approval Analytics"
            description="Processed 3.8 million public mortgage records into a validated analytical dataset and three interactive Tableau dashboards."
            image="/images/projects/mortgage-market-overview.png"
            imageAlt="Mortgage Market Overview dashboard showing mortgage approval analytics across four U.S. states"
            tools="Python · DuckDB · SQL · Tableau"
            caseStudyHref="/projects/mortgage-approval-analytics/"
            metrics={[
              { value: '3.8M', label: 'raw records' },
              { value: '4', label: 'states analyzed' },
              { value: '3', label: 'dashboards' }
            ]}
            externalLinks={[
              {
                label: 'Open Tableau',
                href: 'https://public.tableau.com/views/MortgageApprovalAnalytics2017HMDA/MortgageMarketOverview?:language=en-US&:sid=&:display_count=n&:origin=viz_share_link'
              },
              {
                label: 'GitHub',
                href: 'https://github.com/Ryan-Wenstrom-Portfolio/mortgage-approval-analytics'
              }
            ]}
          />

          <ProjectCard
            eyebrow="SQL & Data Engineering"
            title="SQL Analytics & Data Engineering"
            description="Built two PostgreSQL case studies spanning large-scale retail analysis and an external-data pipeline from transformation and validation through business reporting."
            image="/images/projects/sql-retail-performance.png"
            imageAlt="Retail Performance Analytics dashboard showing revenue, store performance, product demand, and time-based retail trends"
            tools="PostgreSQL · SQL · Python · Tableau"
            caseStudyHref="/projects/sql-analytics/"
            metrics={[
              { value: '1.54M', label: 'transactions' },
              { value: '$98.7M', label: 'revenue analyzed' },
              { value: '2', label: 'case studies' }
            ]}
            externalLinks={[
              {
                label: 'Open Tableau',
                href: 'https://public.tableau.com/app/profile/ryan.wenstrom2339/viz/SQLAnalyticsDataEngineering/RetailPerformanceAnalytics'
              },
              {
                label: 'GitHub',
                href: 'https://github.com/Ryan-Wenstrom-Portfolio/sql_analytics'
              }
            ]}
          />

          <ProjectCard
            eyebrow="Interactive Analytics"
            title="NBA Player Role Analytics"
            description="Co-developed an interactive D3 application for comparing player roles, historical similarity, roster composition, and team context beyond traditional box-score summaries."
            image="/images/projects/nba-role-explorer.png"
            imageAlt="NBA Player Role Analytics application comparing Jrue Holiday and James Harden"
            tools="Python · D3.js · JavaScript · pandas"
            caseStudyHref="/projects/nba-player-role-analytics/"
            metrics={[
              { value: '5,665', label: 'player-team-seasons' },
              { value: '16', label: 'NBA seasons' },
              { value: '480', label: 'team-seasons' }
            ]}
            externalLinks={[
              {
                label: 'Open Live App',
                href: 'https://ryan-wenstrom-portfolio.github.io/nba-player-role-analytics/'
              },
              {
                label: 'GitHub',
                href: 'https://github.com/Ryan-Wenstrom-Portfolio/nba-player-role-analytics'
              }
            ]}
          />

          <ProjectCard
            eyebrow="Graph Analytics"
            title="Neo4j Stock Network Analysis"
            description="Modeled historical stock-return correlations as a Neo4j network and tested how centrality conclusions change across methods and network-construction thresholds."
            image="/images/projects/neo4j-correlation-network.png"
            imageAlt="NASDAQ stock correlation network showing connected and isolated stocks"
            tools="Neo4j · Cypher · GDS · Python"
            caseStudyHref="/projects/neo4j-stock-network-analysis/"
            metrics={[
              { value: '85', label: 'stocks' },
              { value: '197', label: 'relationships' },
              { value: '4', label: 'thresholds tested' }
            ]}
            externalLinks={[
              {
                label: 'Interactive Network',
                href: '/interactive/neo4j-stock-network.html'
              },
              {
                label: 'GitHub',
                href: 'https://github.com/Ryan-Wenstrom-Portfolio/neo4j-stock-network-analysis'
              }
            ]}
          />
        </div>
      </div>
    </section>

    <section class="capabilities-section">
      <div class="container">
        <div class="capabilities-heading">
          <p class="section-eyebrow">CAPABILITIES</p>
          <h2>From raw data to useful decisions.</h2>
          <p>
            My work sits at the intersection of data, analytical reasoning,
            business context, and communication.
          </p>
        </div>

        <div class="capabilities-grid">
          <article class="capability">
            <p class="capability-number">01</p>
            <h3>Build reliable data</h3>
            <p>
              Transform, validate, reconcile, and structure raw or external
              data into trustworthy analytical datasets.
            </p>
          </article>

          <article class="capability">
            <p class="capability-number">02</p>
            <h3>Analyze business performance</h3>
            <p>
              Use SQL, Python, and business context to identify patterns,
              compare performance, and answer decision-relevant questions.
            </p>
          </article>

          <article class="capability">
            <p class="capability-number">03</p>
            <h3>Build interactive analytics</h3>
            <p>
              Turn analytical results into dashboards and interactive
              applications that make complex information easier to explore.
            </p>
          </article>

          <article class="capability">
            <p class="capability-number">04</p>
            <h3>Model complex relationships</h3>
            <p>
              Use graph structures and network analysis to investigate
              relationships that are difficult to understand in traditional
              tables.
            </p>
          </article>
        </div>
      </div>
    </section>

    <ExperienceSection />
    <AthleticsSection />
    <AboutSection />
    <ResumeConnectSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding: 118px 0 104px;
  }

  .hero-inner {
    max-width: var(--max-width);
  }

  .eyebrow {
    margin: 0 0 20px;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(3.75rem, 7vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .positioning {
    max-width: 900px;
    margin: 26px 0 0;
    font-size: clamp(1.9rem, 3.4vw, 2.55rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .intro {
    max-width: 790px;
    margin: 28px 0 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 160ms ease,
      background 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--color-accent);
    color: #ffffff;
  }

  .button-primary:hover {
    background: var(--color-accent-dark);
  }

  .button-secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    align-items: center;
    margin-top: 24px;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .hero-links a {
    text-decoration: none;
  }

  .hero-links a:hover {
    color: var(--color-accent-dark);
  }

  .credibility {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 15px;
    margin-top: 54px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.83rem;
    font-weight: 650;
    letter-spacing: 0.025em;
  }

  .divider {
    width: 1px;
    height: 14px;
    background: var(--color-border);
  }

  .projects-section {
    padding: 110px 0 130px;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 50px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.35rem, 4vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .section-heading > p:last-child {
    margin: 22px 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 28px;
  }

  .capabilities-section {
    padding: 118px 0 126px;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .capabilities-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.65fr);
    column-gap: 80px;
    align-items: end;
    margin-bottom: 62px;
  }

  .capabilities-heading .section-eyebrow {
    grid-column: 1 / -1;
  }

  .capabilities-heading h2 {
    margin: 0;
    max-width: 700px;
    font-size: clamp(2.35rem, 4vw, 3.25rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  .capabilities-heading > p:last-child {
    margin: 0;
    max-width: 460px;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .capability {
    min-width: 0;
    padding: 34px 30px 38px 0;
  }

  .capability + .capability {
    padding-left: 30px;
    border-left: 1px solid var(--color-border);
  }

  .capability-number {
    margin: 0 0 28px;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .capability h3 {
    margin: 0;
    max-width: 240px;
    font-size: 1.32rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .capability > p:last-child {
    margin: 17px 0 0;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .capabilities-heading {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }

    .capabilities-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .capability {
      padding: 30px;
    }

    .capability:nth-child(3) {
      padding-left: 30px;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .capability:nth-child(4) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 800px) {
    .projects-section {
      padding: 80px 0 90px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .capabilities-section {
      padding: 82px 0 92px;
    }

    .capabilities-heading {
      margin-bottom: 42px;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding: 76px 0 72px;
    }

    h1 {
      font-size: clamp(3.25rem, 15vw, 4.25rem);
    }

    .positioning {
      font-size: clamp(1.65rem, 8vw, 2.1rem);
    }

    .intro {
      margin-top: 24px;
      font-size: 1rem;
    }
  }

  @media (max-width: 620px) {
    .capabilities-grid {
      grid-template-columns: 1fr;
    }

    .capability,
    .capability + .capability,
    .capability:nth-child(3) {
      padding: 28px 0;
      border-left: 0;
    }

    .capability + .capability {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 520px) {
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .button {
      width: 100%;
    }

    .divider {
      display: none;
    }

    .credibility {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
