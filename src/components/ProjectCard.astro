---
interface Metric {
  value: string;
  label: string;
}

interface ExternalLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  tools: string;
  metrics: Metric[];
  caseStudyHref?: string;
  externalLinks?: ExternalLink[];
}

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  tools,
  metrics,
  caseStudyHref,
  externalLinks = []
} = Astro.props;
---

<article class="project-card">
  <div class="project-image">
    <img src={image} alt={imageAlt} loading="lazy" />
  </div>

  <div class="project-content">
    <p class="project-eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p class="project-description">{description}</p>
    <p class="project-tools">{tools}</p>

    <div class="project-metrics" aria-label={`${title} project highlights`}>
      {
        metrics.map((metric) => (
          <div class="metric">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))
      }
    </div>

    <div class="project-links">
      {
        caseStudyHref && (
          <a class="case-link" href={caseStudyHref}>
            View Case Study
            <span aria-hidden="true">→</span>
          </a>
        )
      }

      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: #c8d2d9;
    box-shadow: var(--shadow-soft);
  }

  .project-image {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
    background: #eef2f4;
    border-bottom: 1px solid var(--color-border);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 30px;
  }

  .project-eyebrow {
    margin: 0 0 10px;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.55rem, 2.6vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .project-description {
    min-height: 4.95em;
    margin: 16px 0 0;
    color: var(--color-text-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .project-tools {
    margin: 20px 0 0;
    color: var(--color-text);
    font-size: 0.84rem;
    font-weight: 650;
  }

  .project-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .metric {
    min-width: 0;
    padding-right: 14px;
  }

  .metric + .metric {
    padding-left: 14px;
    border-left: 1px solid var(--color-border);
  }

  .metric strong,
  .metric span {
    display: block;
  }

  .metric strong {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .metric span {
    margin-top: 5px;
    color: var(--color-text-muted);
    font-size: 0.73rem;
    line-height: 1.35;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: auto;
    padding-top: 22px;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent-dark);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .project-links .case-link {
    color: var(--color-text);
  }

  .project-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 600px) {
    .project-content {
      padding: 24px;
    }

    .project-image {
      padding: 10px;
    }

    .project-description {
      min-height: 0;
    }

    .project-metrics {
      grid-template-columns: 1fr;
    }

    .metric {
      padding: 0;
    }

    .metric + .metric {
      padding: 14px 0 0;
      margin-top: 14px;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
